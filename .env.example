# ---------------------------------------------------------------------------
# SAAC · Variables de entorno (copiar a .env y cambiar TODAS las claves)
# ---------------------------------------------------------------------------
SAAC_ENTORNO=desarrollo

# Base de datos (contraseñas de los tres usuarios de PostgreSQL)
SAAC_BD_CLAVE_ADMIN=cambiar-admin
SAAC_BD_CLAVE_ACADEMICO=cambiar-academico
SAAC_BD_CLAVE_NUCLEO=cambiar-nucleo

# Seguridad: genere valores aleatorios largos
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SAAC_CLAVE_JWT=cambiar
SAAC_CLAVE_SEUDONIMO=cambiar
# Claves Fernet:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAAC_CLAVE_CIFRADO_NUCLEO=
SAAC_CLAVE_CIFRADO_MENSAJES=
# Restringir el registro a correos institucionales (lista JSON); vacío = cualquier dominio
SAAC_DOMINIOS_CORREO_PERMITIDOS=[]

# ---------------------------------------------------------------------------
# Proveedor de modelos de lenguaje
# ---------------------------------------------------------------------------
# Opción A · Demostración sin modelo (respuestas extractivas):
SAAC_PROVEEDOR_IA=simulado

# Opción B · Modelos de código abierto con Ollama (perfil ia-local):
# SAAC_PROVEEDOR_IA=openai_compatible
# SAAC_IA_URL_BASE=http://ollama:11434/v1
# SAAC_IA_CLAVE_API=ollama
# SAAC_IA_MODELO_CHAT=qwen2.5:7b-instruct
# SAAC_IA_MODELO_EMBEDDINGS=bge-m3

# Opción C · Servicio comercial compatible con la API de OpenAI:
# SAAC_PROVEEDOR_IA=openai_compatible
# SAAC_IA_URL_BASE=https://api.openai.com/v1
# SAAC_IA_CLAVE_API=sk-...
# SAAC_IA_MODELO_CHAT=gpt-4o-mini
# SAAC_IA_MODELO_EMBEDDINGS=text-embedding-3-small   # se solicita con 1024 dimensiones

SAAC_IA_EXTRACTOR_HABILITADO=true
SAAC_URL_PUBLICA=http://localhost:8080

# Prototipo MCP (dejar vacío para deshabilitar la ruta de integración)
SAAC_CLAVE_API_MCP=
